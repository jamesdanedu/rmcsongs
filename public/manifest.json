{
  "name": "RMC Song Wishlist",
  "short_name": "RMC Songs",
  "description": "Suggest, vote, and discover songs for the choir",
  "start_url": "/?source=pwa",
  "id": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay"],
  "orientation": "portrait",
  "theme_color": "#4f46e5",
  "background_color": "#eef2ff",
  "categories": ["music", "social", "utilities"],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "handle_links": "preferred",
  "shortcuts": [
    {
      "name": "Suggest Song",
      "short_name": "Suggest",
      "description": "Suggest a new song for the choir",
      "url": "/?tab=suggest",
